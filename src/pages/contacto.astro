---
import PageIntro from '@/components/PageIntro.astro';
import ContactForm from '@/components/react/ContactForm';
import { Toaster } from '@/components/react/Toaster';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contactEmail, socialLinks } from '@/lib/data';
---

<BaseLayout title="Contacto" description="Cuéntame tu proyecto de fotografía o vídeo y te preparo un presupuesto.">
  <PageIntro eyebrow="Contacto" title="Hablemos" />

  <section class="grid gap-16 px-5 pb-24 sm:px-10 lg:grid-cols-[2fr_3fr] lg:gap-24">
    <div class="space-y-10">
      <p class="max-w-md text-lg leading-relaxed text-linen/70">
        ¿Tienes un proyecto en mente? Cuéntame lo que necesitas y buscamos la forma de hacerlo realidad.
      </p>
      <div>
        <p class="text-xs font-medium text-gold">Email</p>
        <a
          href={`mailto:${contactEmail}`}
          class="mt-2 block break-all font-headline text-2xl tracking-wide text-linen hover:text-gold sm:text-3xl"
        >
          {contactEmail}
        </a>
      </div>
      <div>
        <p class="text-xs font-medium text-gold">Redes</p>
        <ul class="mt-2 space-y-1">
          {
            socialLinks
              .filter((link) => !link.href.startsWith('mailto:'))
              .map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-headline text-2xl uppercase tracking-wide text-linen hover:text-gold"
                  >
                    {label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
    </div>
    <ContactForm client:load />
  </section>
  <Toaster client:load />
</BaseLayout>
