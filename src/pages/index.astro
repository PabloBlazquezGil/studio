---
import { ArrowRight } from '@lucide/astro';
import BentoGrid from '@/components/BentoGrid.astro';
import HeroCarousel from '@/components/HeroCarousel.astro';
import Parallax from '@/components/motion/Parallax.astro';
import ReelsSection from '@/components/ReelsSection.astro';
import Reveal from '@/components/Reveal.astro';
import ScrollMarquee from '@/components/motion/ScrollMarquee.astro';
import SplitHeading from '@/components/motion/SplitHeading.astro';
import Testimonials from '@/components/Testimonials.astro';
import BeforeAfter from '@/components/react/BeforeAfter';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { author, comparisons, heroSlides, marqueeWords, projects } from '@/lib/data';
import { getProject } from '@/lib/projects';

const slides = heroSlides.flatMap((slide) => {
  const project = getProject(slide.projectSlug);
  return project ? [{ ...slide, project }] : [];
});
---

<BaseLayout>
  <HeroCarousel slides={slides} />

  <section class="px-5 pb-16 pt-20 text-center sm:px-10 sm:pt-28">
    <SplitHeading
      as="h1"
      lines={['Luz. Movimiento.', '*Emoción.*']}
      class="text-6xl font-bold leading-[0.88] text-linen sm:text-8xl lg:text-[10rem]"
    />
    <Reveal delay={300}>
      <p class="mt-8 text-sm text-linen/60 sm:text-base">Fotografía · Vídeo · Dirección de fotografía</p>
    </Reveal>
  </section>

  <section class="px-2.5 sm:px-10" aria-label="Trabajos destacados">
    <BentoGrid projects={projects} />
    <div class="mt-12 text-center">
      <a
        href="/trabajos"
        class="inline-flex items-center gap-2 border border-linen/30 px-6 py-3 font-headline text-lg uppercase tracking-wide text-linen transition-colors hover:border-gold hover:text-gold"
      >
        Todos los trabajos <ArrowRight class="h-4 w-4" />
      </a>
    </div>
  </section>

  <ScrollMarquee words={marqueeWords} />

  <ReelsSection />

  {
    comparisons.length > 0 && (
      <section class="border-t border-linen/10 px-5 py-24 sm:px-10 sm:py-32">
        <p class="text-sm font-medium text-gold">Postproducción</p>
        <SplitHeading lines={['Antes y *después*']} class="mt-3 text-5xl font-bold leading-[0.9] text-linen sm:text-7xl" />
        <div class="mt-12 grid gap-10 lg:grid-cols-2">
          {comparisons.map((comparison) => (
            <BeforeAfter client:visible comparison={comparison} />
          ))}
        </div>
      </section>
    )
  }

  <section class="grid items-center gap-10 border-t border-linen/10 px-5 py-24 sm:px-10 sm:py-32 lg:grid-cols-2 lg:gap-20">
    <Reveal class="relative aspect-[4/5] overflow-hidden lg:order-2">
      <Parallax>
        <img
          src={author.imageUrl}
          alt={author.name}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </Parallax>
    </Reveal>
    <div>
      <p class="text-sm font-medium text-gold">Sobre mí</p>
      <SplitHeading lines={[author.title]} class="mt-3 text-5xl font-bold leading-[0.9] text-linen sm:text-7xl" />
      <Reveal delay={150}>
        <p class="mt-6 max-w-lg leading-relaxed text-linen/70">{author.bio.split('\n\n')[0]}</p>
        <a
          href="/sobre-mi"
          class="mt-8 inline-flex items-center gap-2 bg-linen/10 px-5 py-2.5 font-headline text-lg uppercase tracking-wide text-linen transition-colors hover:bg-gold hover:text-canopy"
        >
          Conóceme <ArrowRight class="h-4 w-4" />
        </a>
      </Reveal>
    </div>
  </section>

  <Testimonials />
</BaseLayout>
