---
import PageIntro from '@/components/PageIntro.astro';
import Reveal from '@/components/Reveal.astro';
import SplitHeading from '@/components/motion/SplitHeading.astro';
import Testimonials from '@/components/Testimonials.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { author, services } from '@/lib/data';
import { breadcrumbs } from '@/lib/seo';
import { ArrowRight } from '@lucide/astro';

const site = Astro.site ?? new URL(Astro.url.origin);
---

<BaseLayout
  title="Sobre mí y servicios"
  description={`${author.name}, fotógrafo y videógrafo. Fotografía deportiva y de surf, retrato y photobook, eventos, cortometrajes, reels y postproducción.`}
  jsonLd={[
    { '@type': 'ProfilePage', url: new URL('/sobre-mi/', site).href, mainEntity: { '@id': new URL('/#person', site).href } },
    breadcrumbs(site, [{ name: 'Sobre mí', path: '/sobre-mi/' }]),
  ]}
>
  <PageIntro eyebrow="Sobre mí" title={author.title} />

  <section class="grid gap-10 px-5 pb-24 sm:px-10 lg:grid-cols-2 lg:gap-20">
    <Reveal class="relative aspect-4/5 overflow-hidden">
      <img
        src={author.imageUrl}
        alt={`${author.name}, fotógrafo y videógrafo`}
        sizes="(max-width: 1024px) 100vw, 50vw"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </Reveal>
    <Reveal delay={120} class="space-y-6 text-lg leading-relaxed text-linen/80 lg:pt-10">
      {author.bio.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
    </Reveal>
  </section>

  <section class="border-t border-linen/10 px-5 py-24 sm:px-10 sm:py-32">
    <SplitHeading lines={['Servicios']} class="text-5xl font-bold leading-none text-linen sm:text-8xl" />
    <ol class="mt-12 border-t border-linen/15">
      {
        services.map((service, index) => (
          <li class="grid gap-3 border-b border-linen/15 py-8 md:grid-cols-[6rem_2fr_3fr] md:gap-8">
            <span class="font-headline text-xl text-gold">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="font-headline text-3xl font-bold uppercase leading-none text-linen sm:text-4xl">
              <a href={`/servicios/${service.slug}`} class="transition-colors hover:text-gold">{service.title}</a>
            </h3>
            <div>
              <p class="leading-relaxed text-linen/70">{service.description}</p>
              <a
                href={`/servicios/${service.slug}`}
                class="mt-3 inline-flex items-center gap-2 text-sm text-gold hover:text-linen"
                aria-label={`Más sobre ${service.title.toLowerCase()}`}
              >
                Ver servicio <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <Testimonials />
</BaseLayout>
