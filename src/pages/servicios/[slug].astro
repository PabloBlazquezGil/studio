---
import { ArrowRight, Check } from '@lucide/astro';
import PageIntro from '@/components/PageIntro.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Reveal from '@/components/Reveal.astro';
import SplitHeading from '@/components/motion/SplitHeading.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, services } from '@/lib/data';
import { getSocialImage } from '@/lib/projects';
import { serviceGraph } from '@/lib/seo';
import type { Service } from '@/lib/types';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const site = Astro.site ?? new URL(Astro.url.origin);
const examples = service.projectSlugs.flatMap((slug) => projects.filter((p) => p.slug === slug));
const others = services.filter((s) => s.slug !== service.slug);

/** Cómo trabajo: igual para todos los servicios. */
const process = [
  ['Me cuentas tu idea', 'Qué necesitas, para qué lo vas a usar, fechas y lugar.'],
  ['Propuesta y presupuesto', 'Te propongo un enfoque y un presupuesto a medida antes de empezar.'],
  ['Sesión o rodaje', 'Fotografío o grabo cuidando la luz, el ritmo y cada detalle.'],
  ['Edición y entrega', 'Selección, edición y color, listo en los formatos que necesites.'],
];
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  image={examples.map(getSocialImage).find(Boolean)}
  jsonLd={serviceGraph(service, site)}
>
  <nav aria-label="Migas de pan" class="absolute left-5 top-20 z-10 text-xs text-linen/50 sm:left-10 sm:top-28">
    <ol class="flex gap-2">
      <li><a href="/" class="hover:text-gold">Inicio</a> /</li>
      <li><a href="/servicios" class="hover:text-gold">Servicios</a> /</li>
      <li aria-current="page" class="text-linen/70">{service.title}</li>
    </ol>
  </nav>

  <PageIntro eyebrow="Servicio" title={service.headline} />

  <section class="grid gap-12 px-5 pb-20 sm:px-10 sm:pb-28 lg:grid-cols-[3fr_2fr] lg:gap-24">
    <Reveal class="space-y-6 text-lg leading-relaxed text-linen/80">
      {service.intro.map((paragraph) => <p>{paragraph}</p>)}
      <a
        href={`/contacto?servicio=${service.slug}`}
        class="!mt-10 inline-flex items-center gap-2 bg-gold px-6 py-3 font-headline text-lg uppercase tracking-wide text-canopy transition-colors hover:bg-linen"
      >
        Pide presupuesto <ArrowRight class="h-4 w-4" />
      </a>
    </Reveal>
    <Reveal delay={120} class="space-y-10">
      <div>
        <h2 class="font-headline text-2xl uppercase tracking-wide text-gold">Qué incluye</h2>
        <ul class="mt-5 divide-y divide-linen/10 border-y border-linen/10">
          {
            service.includes.map((item) => (
              <li class="flex gap-3 py-3 text-linen">
                <Check class="mt-1 h-4 w-4 shrink-0 text-gold" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="font-headline text-2xl uppercase tracking-wide text-gold">Para quién</h2>
        <ul class="mt-5 flex flex-wrap gap-2">
          {service.idealFor.map((item) => <li class="border border-linen/20 px-3 py-1.5 text-sm text-linen/80">{item}</li>)}
        </ul>
      </div>
    </Reveal>
  </section>

  {
    examples.length > 0 && (
      <section class="border-t border-linen/10 px-2.5 py-20 sm:px-10 sm:py-28">
        <div class="mb-8 flex items-end justify-between gap-4 px-2.5 sm:px-0">
          <SplitHeading lines={['Trabajos de *ejemplo*']} class="text-4xl font-bold leading-none text-linen sm:text-6xl" />
          <a
            href="/trabajos"
            class="inline-flex shrink-0 items-center gap-2 font-headline text-lg uppercase tracking-wide text-linen/70 hover:text-gold"
          >
            Todos <ArrowRight class="h-4 w-4" />
          </a>
        </div>
        <div class={examples.length % 2 === 0 ? 'grid grid-cols-1 gap-2.5 sm:grid-cols-2' : 'grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3'}>
          {examples.map((p) => <ProjectCard project={p} class="aspect-4/5" />)}
        </div>
      </section>
    )
  }

  <section class="border-t border-linen/10 px-5 py-20 sm:px-10 sm:py-28">
    <SplitHeading lines={['Cómo trabajo']} class="text-4xl font-bold leading-none text-linen sm:text-6xl" />
    <ol class="mt-12 grid gap-px bg-linen/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        process.map(([title, text], index) => (
          <li class="bg-canopy p-6 sm:p-8">
            <span class="font-headline text-xl text-gold">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-headline text-2xl font-bold uppercase leading-none text-linen">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-linen/70">{text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-t border-linen/10 px-5 py-20 sm:px-10 sm:py-28">
    <h2 class="font-headline text-2xl uppercase tracking-wide text-gold">Otros servicios</h2>
    <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
      {
        others.map((s) => (
          <li>
            <a href={`/servicios/${s.slug}`} class="font-headline text-2xl uppercase tracking-wide text-linen transition-colors hover:text-gold sm:text-3xl">
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
