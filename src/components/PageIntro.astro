---
import SplitHeading from './motion/SplitHeading.astro';

interface Props {
  eyebrow: string;
  title: string;
}

/** Cabecera de las páginas interiores: etiqueta pequeña y título grande que se revela letra a letra. */
const { eyebrow, title } = Astro.props;
---

<header class="px-5 pb-10 pt-32 sm:px-10 sm:pt-44">
  <p class="text-sm font-medium text-gold">{eyebrow}</p>
  <SplitHeading
    as="h1"
    immediate
    lines={[title]}
    class="mt-3 text-6xl font-bold leading-[0.9] text-linen sm:text-8xl lg:text-9xl"
  />
  <slot />
</header>
