---
import { toLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { cn } from '@/lib/utils';

/**
 * Los cuatro pasos de un encargo, de la idea a la entrega. Es una secuencia real, por eso va numerada.
 * `compact` los apila en una columna (página de contacto, junto al formulario).
 */
interface Props {
  compact?: boolean;
  class?: string;
}

const { compact = false, class: className } = Astro.props;
const t = useTranslations(toLang(Astro.currentLocale));
---

<ol
  class={cn(
    compact ? 'space-y-5' : 'grid gap-px bg-linen/10 sm:grid-cols-2 lg:grid-cols-4',
    className,
  )}
>
  {
    t.services.steps.map(([title, text], index) =>
      compact ? (
        <li class="grid grid-cols-[2rem_1fr] gap-x-3">
          <span class="font-headline text-lg leading-tight text-gold">{index + 1}</span>
          <div>
            <h3 class="font-headline text-xl font-bold uppercase leading-tight text-linen">{title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-linen/70">{text}</p>
          </div>
        </li>
      ) : (
        <li class="bg-canopy p-6 sm:p-8">
          <span class="font-headline text-xl text-gold">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 font-headline text-2xl font-bold uppercase leading-none text-linen">{title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-linen/70">{text}</p>
        </li>
      ),
    )
  }
</ol>
