---
import type { HeroSlide, Project } from '@/lib/types';
import { cn } from '@/lib/utils';

interface Props {
  slides: (HeroSlide & { project: Project })[];
}

/**
 * Carrusel de vídeos a pantalla completa con indicadores tipo "stories":
 * cada barra se llena mientras dura su clip y se puede saltar tocando una barra.
 */
const { slides } = Astro.props;
const SLIDE_DURATION = 7000;
---

<section
  data-hero
  data-hero-carousel
  data-duration={SLIDE_DURATION}
  class="relative h-svh w-full overflow-hidden bg-canopy"
>
  <div data-hero-media class="absolute inset-0">
    {
      slides.map((slide, index) => (
        <div
          data-slide
          class={cn('absolute inset-0 transition-opacity duration-1000', index === 0 ? 'opacity-100' : 'opacity-0')}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          {/* Solo se descargan el clip actual y el siguiente: el script los carga al llegar su turno */}
          <video
            data-loop
            data-controlled
            data-src={slide.videoUrl}
            class="h-full w-full object-cover"
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          />
        </div>
      ))
    }
  </div>

  <div class="absolute inset-0 bg-linear-to-b from-canopy/60 via-transparent to-canopy/70"></div>

  <div class="absolute inset-x-0 bottom-0 z-10 px-5 pb-8 sm:px-10 sm:pb-10">
    {
      slides.map((slide, index) => (
        <a
          data-caption
          href={`/trabajos/${slide.project.slug}`}
          hidden={index !== 0}
          class="group inline-block [&[hidden]]:hidden"
        >
          <p class="text-xs font-medium text-gold">{slide.project.client}</p>
          <p class="mt-1 font-headline text-2xl font-bold uppercase leading-none text-linen transition-colors group-hover:text-gold sm:text-3xl">
            {slide.project.title}
          </p>
        </a>
      ))
    }

    <div class="mt-6 flex gap-2" role="tablist" aria-label="Clips del showreel">
      {
        slides.map((slide, index) => (
          <button
            type="button"
            role="tab"
            data-tab
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={`Clip ${index + 1}: ${slide.project.title}`}
            class="group relative h-6 flex-1 sm:max-w-24"
          >
            <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 bg-linen/25 transition-colors group-hover:bg-linen/50" />
            <span data-fill class="absolute left-0 top-1/2 h-0.5 w-0 -translate-y-1/2 bg-linen" />
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { controlLoopVideo } from '@/scripts/loop-video';

  const root = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (root) {
    const duration = Number(root.dataset.duration) || 7000;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-tab]')];
    const fills = [...root.querySelectorAll<HTMLElement>('[data-fill]')];
    let current = 0;
    let timer: ReturnType<typeof setTimeout>;

    const show = (index: number) => {
      current = index;
      const next = (current + 1) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('opacity-0', !active);
        slide.setAttribute('aria-hidden', String(!active));
        const video = slide.querySelector<HTMLVideoElement>('video');
        // Solo se descargan el clip actual y el siguiente.
        if (video && (active || i === next)) controlLoopVideo(video, true, active);
        else if (video) controlLoopVideo(video, false, false);
      });
      captions.forEach((c, i) => (c.hidden = i !== current));
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === current)));
      fills.forEach((fill, i) => {
        fill.classList.remove('animate-progress', 'w-full', 'w-0');
        fill.style.animationDuration = '';
        if (i < current) fill.classList.add('w-full');
        else {
          fill.classList.add('w-0');
          if (i === current) {
            void fill.offsetWidth; // reinicia la animación
            fill.classList.add('animate-progress');
            fill.style.animationDuration = `${duration}ms`;
          }
        }
      });
      clearTimeout(timer);
      timer = setTimeout(() => show((current + 1) % slides.length), duration);
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)));
    show(0);
  }
</script>
