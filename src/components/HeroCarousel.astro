---
import type { HeroSlide, Project } from '@/lib/types';
import { Pause, Play } from '@lucide/astro';
import { projectPath, toLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { cn } from '@/lib/utils';

interface Props {
  slides: (HeroSlide & { project: Project })[];
}

/**
 * Carrusel de vídeos a pantalla completa con indicadores tipo "stories":
 * cada barra se llena mientras dura su clip y se puede saltar tocando una barra.
 */
const { slides } = Astro.props;
const SLIDE_DURATION = 7000;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section
  data-hero
  data-hero-carousel
  data-duration={SLIDE_DURATION}
  class="relative h-svh w-full overflow-hidden bg-canopy"
>
  <div data-hero-media class="absolute inset-0">
    {
      slides.map((slide, index) => (
        <div
          data-slide
          class={cn('absolute inset-0 transition-opacity duration-1000', index === 0 ? 'opacity-100' : 'opacity-0')}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          {/* Solo se descargan el clip actual y el siguiente: el script los carga al llegar su turno */}
          <video
            data-loop
            data-controlled
            data-src={slide.videoUrl}
            class="h-full w-full object-cover"
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          />
        </div>
      ))
    }
  </div>

  <div class="absolute inset-0 bg-linear-to-b from-canopy/60 via-transparent to-canopy/70"></div>

  <div class="absolute inset-x-0 bottom-0 z-10 px-5 pb-8 sm:px-10 sm:pb-10">
    {
      slides.map((slide, index) => (
        <a
          data-caption
          href={projectPath(slide.project.slug, lang)}
          hidden={index !== 0}
          class="group inline-block [&[hidden]]:hidden"
        >
          <p class="text-xs font-medium text-gold">{slide.project.client}</p>
          <p class="mt-1 font-headline text-2xl font-bold uppercase leading-none text-linen transition-colors group-hover:text-gold sm:text-3xl">
            {slide.project.title}
          </p>
        </a>
      ))
    }

    <div class="mt-6 flex items-center gap-2">
    <button
      type="button"
      data-toggle
      aria-label={t.hero.pause}
      data-label-pause={t.hero.pause}
      data-label-play={t.hero.play}
      class="-ml-2 mr-1 p-2 text-linen/70 transition-colors hover:text-gold"
    >
      <Pause class="h-4 w-4" data-icon="pause" />
      <Play class="hidden h-4 w-4" data-icon="play" />
    </button>
    <div class="flex flex-1 gap-2" role="tablist" aria-label={t.hero.clips}>
      {
        slides.map((slide, index) => (
          <button
            type="button"
            role="tab"
            data-tab
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={t.hero.clip(index + 1, slide.project.title)}
            class="group relative h-6 flex-1 sm:max-w-24"
          >
            <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 bg-linen/25 transition-colors group-hover:bg-linen/50" />
            <span data-fill class="absolute left-0 top-1/2 h-0.5 w-0 -translate-y-1/2 bg-linen" />
          </button>
        ))
      }
    </div>
    </div>
  </div>

  <a
    href="#trabajos-destacados"
    aria-label={t.hero.seeWork}
    class="absolute bottom-8 right-5 z-10 hidden items-center gap-2 text-xs font-medium text-linen/70 transition-colors hover:text-gold sm:flex sm:right-10 sm:bottom-10"
  >
    {t.hero.scroll} <span aria-hidden="true" class="block h-8 w-px animate-pulse bg-gold"></span>
  </a>
</section>

<script>
  import { controlLoopVideo } from '@/scripts/loop-video';

  const root = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (root) {
    const duration = Number(root.dataset.duration) || 7000;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-tab]')];
    const fills = [...root.querySelectorAll<HTMLElement>('[data-fill]')];
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    // El usuario lo pausa; o se pausa solo si la pestaña está oculta o el hero ya no se ve.
    let userPaused = reduced.matches;
    let visible = true;

    const running = () => !userPaused && visible && !document.hidden;

    // El siguiente clip solo se empieza a descargar cuando el actual ya puede reproducirse:
    // así el primero no compite por el ancho de banda (en móvil, la diferencia es de segundos).
    const videoAt = (i: number) => slides[i]?.querySelector<HTMLVideoElement>('video') ?? null;
    const preloadNext = () => {
      const next = videoAt((current + 1) % slides.length);
      if (next) controlLoopVideo(next, true, false);
    };

    const playVideo = (play: boolean) => {
      slides.forEach((_, i) => {
        const video = videoAt(i);
        if (video) controlLoopVideo(video, i === current, play && i === current);
      });
      const active = videoAt(current);
      if (!active) return;
      if (active.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) preloadNext();
      else active.addEventListener('canplaythrough', preloadNext, { once: true });
    };

    const show = (index: number) => {
      current = index;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('opacity-0', !active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      playVideo(running());
      captions.forEach((c, i) => (c.hidden = i !== current));
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === current)));
      fills.forEach((fill, i) => {
        fill.classList.remove('animate-progress', 'w-full', 'w-0');
        fill.style.animationDuration = '';
        if (i < current) fill.classList.add('w-full');
        else if (i === current && running()) {
          fill.classList.add('w-0');
          void fill.offsetWidth; // reinicia la animación
          fill.classList.add('animate-progress');
          fill.style.animationDuration = `${duration}ms`;
        } else fill.classList.add(i === current && userPaused ? 'w-full' : 'w-0');
      });
      clearTimeout(timer);
      timer = running() ? setTimeout(() => show((current + 1) % slides.length), duration) : undefined;
    };

    const sync = () => {
      const label = (userPaused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '';
      toggle.setAttribute('aria-label', label);
      toggle.querySelector('[data-icon="pause"]')?.classList.toggle('hidden', userPaused);
      toggle.querySelector('[data-icon="play"]')?.classList.toggle('hidden', !userPaused);
      show(current);
    };

    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      sync();
    });
    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)));
    document.addEventListener('visibilitychange', () => show(current));
    new IntersectionObserver(
      ([entry]) => {
        const nowVisible = entry.intersectionRatio > 0.25;
        if (nowVisible !== visible) {
          visible = nowVisible;
          show(current);
        }
      },
      { threshold: [0, 0.25] },
    ).observe(root);

    // Deslizar con el dedo para cambiar de clip.
    let startX = 0;
    root.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    root.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) < 50) return;
        show((current + (dx < 0 ? 1 : -1) + slides.length) % slides.length);
      },
      { passive: true },
    );

    sync();
  }
</script>
