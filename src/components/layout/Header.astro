---
import { Menu, X } from '@lucide/astro';
import LogoMark from '@/components/brand/LogoMark.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { author } from '@/lib/data';
import { isProjectPath, isRoute, normalizePath, path, toLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { cn } from '@/lib/utils';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const home = path('home', lang);
const contact = path('contact', lang);

const navLinks = [
  { href: path('work', lang), label: t.nav.work },
  { href: path('services', lang), label: t.nav.services },
  { href: path('about', lang), label: t.nav.about },
  { href: contact, label: t.nav.contact },
];

// Sin la barra final, para comparar rutas igual que en cualquier alojamiento.
const pathname = normalizePath(Astro.url.pathname);
/** Las páginas que empiezan con un vídeo o imagen a pantalla completa llevan la cabecera transparente. */
const fullBleedHero = isRoute(pathname, 'home') || isProjectPath(pathname);
const onContact = isRoute(pathname, 'contact');
---

<header
  id="site-header"
  data-full-bleed={fullBleedHero ? '' : undefined}
  class={cn(
    'group/header fixed inset-x-0 top-0 z-50 transition-colors duration-500',
    fullBleedHero ? 'bg-transparent data-[solid]:bg-canopy/95 data-[solid]:backdrop-blur-md' : 'bg-canopy/95 backdrop-blur-md',
  )}
>
  <div class="flex h-16 items-center justify-between px-5 sm:h-20 sm:px-10">
    <a href={home} class="flex items-center gap-3" aria-label={t.nav.homeLabel(author.name)}>
      <LogoMark class="h-8 shrink-0 text-linen sm:h-9" />
      <span class="max-[439px]:hidden whitespace-nowrap font-headline text-lg uppercase tracking-[0.12em] text-linen sm:text-xl">{author.name}</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex xl:gap-8" aria-label={t.nav.main}>
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={cn(
              'font-headline text-lg uppercase tracking-wide transition-colors hover:text-gold',
              pathname.startsWith(href) ? 'text-gold' : 'text-linen',
            )}
            aria-current={pathname.startsWith(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
      <LanguageSwitch class="font-headline text-lg uppercase tracking-wide text-linen/60 transition-colors hover:text-gold" />
      <a
        href={contact}
        class="border border-gold px-4 py-1.5 font-headline text-lg uppercase tracking-wide text-gold transition-colors hover:bg-gold hover:text-canopy"
      >
        {t.nav.quote}
      </a>
    </nav>

    <div class="flex items-center gap-1 lg:hidden">
    {
      !onContact && (
        <a
          href={contact}
          class="border border-gold px-3 py-1 font-headline text-base uppercase tracking-wide text-gold transition-colors hover:bg-gold hover:text-canopy"
        >
          {t.nav.quote}
        </a>
      )
    }
    <button
      type="button"
      id="menu-toggle"
      class="p-2 text-linen"
      aria-label={t.nav.openMenu}
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu class="h-6 w-6" data-icon="open" />
      <X class="hidden h-6 w-6" data-icon="close" />
    </button>
    </div>
  </div>

  {/* Altura explícita: el desenfoque de la cabecera la convierte en el contenedor de este panel fijo,
       así que `bottom-0` lo dejaba en 72 px de alto en las páginas con la cabecera sólida. */}
  <nav
    id="mobile-menu"
    hidden
    class="fixed inset-x-0 top-16 flex h-[calc(100dvh-4rem)] flex-col justify-between overflow-y-auto bg-canopy px-5 pb-10 pt-8 lg:hidden [&[hidden]]:hidden"
    aria-label={t.nav.mobile}
    data-lenis-prevent
  >
    <ul class="space-y-2">
      {
        [{ href: home, label: t.nav.home }, ...navLinks].map(({ href, label }) => (
          <li>
            <a href={href} class="block font-headline text-5xl uppercase leading-tight text-linen hover:text-gold">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="space-y-6">
      <LanguageSwitch long class="block font-headline text-2xl uppercase tracking-wide text-linen/70 hover:text-gold" />
      <a href={contact} class="block bg-gold py-4 text-center font-headline text-xl uppercase tracking-wide text-canopy">
        {t.nav.requestQuote}
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => header.toggleAttribute('data-solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    toggle.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
  // Al volver con "atrás" desde la caché del navegador, el menú no debe quedar abierto.
  window.addEventListener('pageshow', () => setOpen(false));
</script>
