---
import { ArrowRight } from '@lucide/astro';
import FooterColumn from './FooterColumn.astro';
import LogoMark from '@/components/brand/LogoMark.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { author, socialLinks } from '@/lib/data';
import { path, toLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const contact = path('contact', lang);

const siteMap = [
  { href: path('home', lang), label: t.nav.home },
  { href: path('work', lang), label: t.nav.work },
  { href: path('about', lang), label: t.nav.about },
  { href: contact, label: t.nav.contact },
];

const year = new Date().getFullYear();
---

<footer class="bg-canopy text-linen">
      {/* Llamada a la acción */}
      <section class="border-t border-linen/10 px-5 py-24 text-center sm:px-10 sm:py-32">
        <p class="text-sm font-medium text-gold">{t.footer.eyebrow}</p>
        <a
          href={contact}
          class="group mt-4 inline-block font-headline text-5xl font-bold uppercase leading-[0.95] transition-colors hover:text-gold sm:text-7xl lg:text-8xl"
        >
          {t.footer.cta[0]}
          <br />
          {t.footer.cta[1]}
        </a>
        <div class="mt-8">
          <a
            href={contact}
            class="inline-flex items-center gap-2 bg-gold px-6 py-3 font-headline text-lg uppercase tracking-wide text-canopy transition-colors hover:bg-linen"
          >
            {t.footer.button} <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </section>

      <div class="border-t border-linen/10 px-5 py-12 sm:px-10">
        <div class="grid grid-cols-2 gap-10 sm:grid-cols-4">
          <div class="col-span-2">
            <LogoMark class="h-12 text-linen" />
            <p class="mt-4 font-headline text-2xl uppercase">{author.name}</p>
            <p class="mt-2 max-w-xs text-sm text-linen/60">{t.footer.tagline}</p>
          </div>
          <FooterColumn title={t.footer.sitemap} links={siteMap} />
          <FooterColumn title={t.footer.social} links={socialLinks} external />
        </div>

        <div class="mt-12 flex flex-col gap-1 border-t border-linen/10 pt-6 text-xs text-linen/50 sm:flex-row sm:items-center sm:justify-between">
          <p>
            © {year} {author.name}
          </p>
          <div class="-ml-2 flex gap-2 sm:ml-0 sm:-mr-2">
            <LanguageSwitch long class="px-2 py-3 hover:text-gold" />
            <a href={path('privacy', lang)} class="px-2 py-3 hover:text-gold">
              {t.footer.privacy}
            </a>
            <a href={path('legal', lang)} class="px-2 py-3 hover:text-gold">
              {t.footer.legal}
            </a>
          </div>
        </div>
      </div>
    </footer>
