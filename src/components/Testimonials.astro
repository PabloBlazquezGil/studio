---
import { testimonials } from '@/lib/data';
import Reveal from './Reveal.astro';

/** Opiniones de clientes en tipografía grande. No se muestra hasta que haya alguna en data.ts. */
---

{
  testimonials.length > 0 && (
    <section class="border-t border-linen/10 px-5 py-24 sm:px-10 sm:py-32" aria-label="Opiniones de clientes">
      <p class="text-sm font-medium text-gold">Lo que dicen</p>
      <div class="mt-10 grid gap-16 lg:grid-cols-2">
        {testimonials.map((t, i) => (
          <Reveal delay={i * 120}>
            <blockquote>
              <p class="font-headline text-3xl uppercase leading-tight text-linen sm:text-4xl">“{t.quote}”</p>
              <footer class="mt-6 text-sm text-linen/60">
                <span class="text-linen">{t.name}</span> · {t.role}
              </footer>
            </blockquote>
          </Reveal>
        ))}
      </div>
    </section>
  )
}
