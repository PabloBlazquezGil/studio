---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { langs, ogLocales, toLang, translatePath } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { siteName } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  /** Título de la página. Se muestra como «<título> | Pablo Blázquez Gil». Sin título, el de la home. */
  title?: string;
  description?: string;
  /** Imagen para redes sociales (ruta o URL). Por defecto, /og.jpg. */
  image?: string;
  /** Impide que los buscadores indexen la página (404). */
  noindex?: boolean;
}

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, description = t.site.description, image, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${siteName}` : t.site.title;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image ?? '/og.jpg', site).href;
const ogImageAlt = image ? title : t.site.ogImageAlt;

// La misma página en cada idioma (hreflang), con barra final como las URL que genera el build y el sitemap.
// La 404 no tiene equivalente.
const alternates = noindex
  ? []
  : langs.flatMap((l) => {
      const path = translatePath(Astro.url.pathname, l);
      if (!path) return [];
      return [{ lang: l, href: new URL(path === '/' ? path : `${path}/`, site).href }];
    });
const defaultAlternate = alternates.find((a) => a.lang === 'es');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Las fotos y vídeos viven en archivos.thundershoot.com, que puede rechazar peticiones con referer de otro dominio
         (protección anti-hotlinking). Sin referer, como hacía Next al servir las imágenes por su servidor, cargan igual. -->
    <meta name="referrer" content="no-referrer" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocales[a.lang]} />)}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="2048" />}
    {!image && <meta property="og:image:height" content="1518" />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Las animaciones de entrada solo ocultan el contenido si JavaScript va a mostrarlo después. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="font-body antialiased">
    <a
      href="#contenido"
      class="fixed left-4 top-4 z-[100] -translate-y-24 bg-gold px-4 py-2 font-headline text-lg uppercase tracking-wide text-canopy transition-transform focus:translate-y-0"
    >
      {t.site.skipToContent}
    </a>
    <Header />
    <main id="contenido" tabindex="-1" class="outline-none">
      {/*
        Transición entre páginas: al entrar en cada página, una cortina del color de fondo
        con una línea dorada se retira hacia arriba y el contenido aparece debajo.
      */}
      <div
        class="pointer-events-none fixed inset-0 z-[70] animate-curtain bg-canopy motion-reduce:hidden"
        aria-hidden="true"
      >
        <div class="absolute inset-x-0 bottom-0 h-0.5 bg-gold"></div>
      </div>
      <div class="animate-page-in motion-reduce:animate-none">
        <slot />
      </div>
    </main>
    <Footer />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
