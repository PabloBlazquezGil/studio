---
import PageIntro from '@/components/PageIntro.astro';
import Reveal from '@/components/Reveal.astro';
import SplitHeading from '@/components/motion/SplitHeading.astro';
import Testimonials from '@/components/Testimonials.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowRight } from '@lucide/astro';
import { servicePath, toLang } from '@/i18n/routes';
import { pageGraph } from '@/lib/seo';
import { useTranslations } from '@/i18n/ui';
import Picture from '@/components/Picture.astro';
import { getAuthor, getServices } from '@/lib/content';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const author = getAuthor(lang);
const services = getServices(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
---

<BaseLayout
  title={t.about.metaTitle}
  description={t.about.description(author.name)}
  jsonLd={pageGraph('ProfilePage', 'about', site, lang)}
>
  <PageIntro eyebrow={t.about.title} title={author.title} />

  <section class="grid gap-10 px-5 pb-24 sm:px-10 lg:grid-cols-2 lg:gap-20">
    <Reveal class="relative aspect-4/5 overflow-hidden">
      <Picture
        src={author.imageUrl}
        alt={t.about.portraitAlt(author.name)}
        sizes="(max-width: 1024px) 100vw, 50vw"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </Reveal>
    <Reveal delay={120} class="space-y-6 text-lg leading-relaxed text-linen/80 lg:pt-10">
      {author.bio.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
    </Reveal>
  </section>

  <section class="border-t border-linen/10 px-5 py-24 sm:px-10 sm:py-32">
    <SplitHeading lines={[t.about.services]} class="text-5xl font-bold leading-none text-linen sm:text-8xl" />
    <ol class="mt-12 border-t border-linen/15">
      {
        services.map((service, index) => (
          <li class="grid gap-3 border-b border-linen/15 py-8 md:grid-cols-[6rem_2fr_3fr] md:gap-8">
            <span class="font-headline text-xl text-gold">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="font-headline text-3xl font-bold uppercase leading-none text-linen sm:text-4xl">
              <a href={servicePath(service.slug, lang)} class="transition-colors hover:text-gold">{service.title}</a>
            </h3>
            <div>
              <p class="leading-relaxed text-linen/70">{service.description}</p>
              <a
                href={servicePath(service.slug, lang)}
                class="mt-3 inline-flex items-center gap-2 text-sm text-gold hover:text-linen"
                aria-label={t.about.seeServiceLabel(service.title)}
              >
                {t.about.seeService} <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <Testimonials />
</BaseLayout>
