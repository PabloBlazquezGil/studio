---
import { ArrowRight } from '@lucide/astro';
import PageIntro from '@/components/PageIntro.astro';
import Reveal from '@/components/Reveal.astro';
import SplitHeading from '@/components/motion/SplitHeading.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { path, servicePath, toLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getServices } from '@/lib/content';
import { serviceListGraph } from '@/lib/seo';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const services = getServices(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
---

<BaseLayout title={t.services.metaTitle} description={t.services.description} jsonLd={serviceListGraph(site, lang, t.services.faq)}>
  <PageIntro eyebrow={t.services.eyebrow} title={t.services.heading}>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-linen/70">{t.services.intro}</p>
  </PageIntro>

  <section class="px-5 pb-24 sm:px-10 sm:pb-32">
    <ol class="border-t border-linen/15">
      {
        services.map((service, index) => (
          <li>
            <a
              href={servicePath(service.slug, lang)}
              class="group grid gap-3 border-b border-linen/15 py-8 transition-colors hover:border-gold/60 md:grid-cols-[6rem_2fr_3fr_auto] md:items-center md:gap-8"
            >
              <span class="font-headline text-xl text-gold">{String(index + 1).padStart(2, '0')}</span>
              <h2 class="font-headline text-3xl font-bold uppercase leading-none text-linen transition-colors group-hover:text-gold sm:text-4xl">
                {service.title}
              </h2>
              <p class="leading-relaxed text-linen/70">{service.description}</p>
              <ArrowRight class="hidden h-6 w-6 text-linen/60 transition-all group-hover:translate-x-1 group-hover:text-gold md:block" />
            </a>
          </li>
        ))
      }
    </ol>
    <Reveal class="mt-16 text-center">
      <a
        href={path('contact', lang)}
        class="inline-flex items-center gap-2 bg-gold px-6 py-3 font-headline text-lg uppercase tracking-wide text-canopy transition-colors hover:bg-linen"
      >
        {t.services.cta} <ArrowRight class="h-4 w-4" />
      </a>
    </Reveal>
  </section>

  <section class="border-t border-linen/10 px-5 py-20 sm:px-10 sm:py-28">
    <SplitHeading
      lines={t.services.faqHeading}
      class="text-4xl font-bold leading-none text-linen sm:text-6xl"
    />
    <div class="mt-12 max-w-3xl border-t border-linen/15">
      {
        t.services.faq.map(([question, answer]) => (
          <details class="group border-b border-linen/15">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg text-linen transition-colors hover:text-gold [&::-webkit-details-marker]:hidden">
              <h3 class="font-body font-medium">{question}</h3>
              <span class="shrink-0 font-headline text-2xl text-gold transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="pb-6 leading-relaxed text-linen/70">{answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
