---
import { ArrowRight, Check } from '@lucide/astro';
import PageIntro from '@/components/PageIntro.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Reveal from '@/components/Reveal.astro';
import SplitHeading from '@/components/motion/SplitHeading.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { path, servicePath, toLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getProjects, getService, getServices } from '@/lib/content';
import { getSocialImage } from '@/lib/projects';
import { serviceGraph } from '@/lib/seo';

interface Props {
  slug: string;
}

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const service = getService(Astro.props.slug, lang)!;
const site = Astro.site ?? new URL(Astro.url.origin);
const projects = getProjects(lang);
const examples = service.projectSlugs.flatMap((slug) => projects.filter((p) => p.slug === slug));
const others = getServices(lang).filter((s) => s.slug !== service.slug);
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  image={examples.map(getSocialImage).find(Boolean)}
  jsonLd={serviceGraph(service, site, lang)}
>
  <nav aria-label={t.services.breadcrumb} class="absolute left-5 top-20 z-10 text-xs text-linen/50 sm:left-10 sm:top-28">
    <ol class="flex gap-2">
      <li><a href={path('home', lang)} class="hover:text-gold">{t.nav.home}</a> /</li>
      <li><a href={path('services', lang)} class="hover:text-gold">{t.nav.services}</a> /</li>
      <li aria-current="page" class="text-linen/70">{service.title}</li>
    </ol>
  </nav>

  <PageIntro eyebrow={t.services.serviceEyebrow} title={service.headline} />

  <section class="grid gap-12 px-5 pb-20 sm:px-10 sm:pb-28 lg:grid-cols-[3fr_2fr] lg:gap-24">
    <Reveal class="space-y-6 text-lg leading-relaxed text-linen/80">
      {service.intro.map((paragraph) => <p>{paragraph}</p>)}
      <a
        href={`${path('contact', lang)}?servicio=${service.slug}`}
        class="!mt-10 inline-flex items-center gap-2 bg-gold px-6 py-3 font-headline text-lg uppercase tracking-wide text-canopy transition-colors hover:bg-linen"
      >
        {t.services.cta} <ArrowRight class="h-4 w-4" />
      </a>
    </Reveal>
    <Reveal delay={120} class="space-y-10">
      <div>
        <h2 class="font-headline text-2xl uppercase tracking-wide text-gold">{t.services.includes}</h2>
        <ul class="mt-5 divide-y divide-linen/10 border-y border-linen/10">
          {
            service.includes.map((item) => (
              <li class="flex gap-3 py-3 text-linen">
                <Check class="mt-1 h-4 w-4 shrink-0 text-gold" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="font-headline text-2xl uppercase tracking-wide text-gold">{t.services.idealFor}</h2>
        <ul class="mt-5 flex flex-wrap gap-2">
          {service.idealFor.map((item) => <li class="border border-linen/20 px-3 py-1.5 text-sm text-linen/80">{item}</li>)}
        </ul>
      </div>
    </Reveal>
  </section>

  {
    examples.length > 0 && (
      <section class="border-t border-linen/10 px-2.5 py-20 sm:px-10 sm:py-28">
        <div class="mb-8 flex items-end justify-between gap-4 px-2.5 sm:px-0">
          <SplitHeading lines={t.services.examples} class="text-4xl font-bold leading-none text-linen sm:text-6xl" />
          <a
            href={path('work', lang)}
            class="inline-flex shrink-0 items-center gap-2 font-headline text-lg uppercase tracking-wide text-linen/70 hover:text-gold"
          >
            {t.services.allWork} <ArrowRight class="h-4 w-4" />
          </a>
        </div>
        <div
          class={
            examples.length % 2 === 0
              ? 'grid grid-cols-1 gap-2.5 sm:grid-cols-2'
              : 'grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3'
          }
        >
          {examples.map((p) => <ProjectCard project={p} class="aspect-4/5" />)}
        </div>
      </section>
    )
  }

  <section class="border-t border-linen/10 px-5 py-20 sm:px-10 sm:py-28">
    <SplitHeading lines={t.services.process} class="text-4xl font-bold leading-none text-linen sm:text-6xl" />
    <ol class="mt-12 grid gap-px bg-linen/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.services.steps.map(([title, text], index) => (
          <li class="bg-canopy p-6 sm:p-8">
            <span class="font-headline text-xl text-gold">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-headline text-2xl font-bold uppercase leading-none text-linen">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-linen/70">{text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-t border-linen/10 px-5 py-20 sm:px-10 sm:py-28">
    <h2 class="font-headline text-2xl uppercase tracking-wide text-gold">{t.services.others}</h2>
    <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
      {
        others.map((s) => (
          <li>
            <a
              href={servicePath(s.slug, lang)}
              class="font-headline text-2xl uppercase tracking-wide text-linen transition-colors hover:text-gold sm:text-3xl"
            >
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
