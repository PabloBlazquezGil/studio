---
import PageIntro from '@/components/PageIntro.astro';
import ContactForm from '@/components/react/ContactForm';
import { Toaster } from '@/components/react/Toaster';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { toLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { contactEmail, socialLinks } from '@/lib/data';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<BaseLayout title={t.contact.title} description={t.contact.description}>
  <PageIntro eyebrow={t.contact.title} title={t.contact.heading} />

  <section class="grid gap-16 px-5 pb-24 sm:px-10 lg:grid-cols-[2fr_3fr] lg:gap-24">
    <div class="space-y-10">
      <p class="max-w-md text-lg leading-relaxed text-linen/70">
        {t.contact.intro}
      </p>
      <div>
        <p class="text-xs font-medium text-gold">{t.contact.email}</p>
        <a
          href={`mailto:${contactEmail}`}
          class="mt-2 block break-all font-headline text-2xl tracking-wide text-linen hover:text-gold sm:text-3xl"
        >
          {contactEmail}
        </a>
      </div>
      <div>
        <p class="text-xs font-medium text-gold">{t.contact.social}</p>
        <ul class="mt-2 space-y-1">
          {
            socialLinks
              .filter((link) => !link.href.startsWith('mailto:'))
              .map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-headline text-2xl uppercase tracking-wide text-linen hover:text-gold"
                  >
                    {label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
    </div>
    <ContactForm client:load lang={lang} />
  </section>
  <Toaster client:load />
</BaseLayout>
